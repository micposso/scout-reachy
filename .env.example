# Copy to .env and fill in. .env is gitignored.

# ---------- Anthropic (vision + reasoning brain) ----------
# https://console.anthropic.com -> API Keys. The SDK reads this directly.
ANTHROPIC_API_KEY=
# Must be a VISION-capable model (reads the camera frame). Sonnet is the cost
# default; bump to claude-opus-4-8 only if sign-reading accuracy needs it.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional: use a different model just for the vision turn. Blank = ANTHROPIC_MODEL.
VISION_MODEL=

# ---------- ElevenLabs (spoken output) ----------
# https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=
# A clear English voice ID from the ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# ---------- OpenStreetMap (free maps backend, no key needed) ----------
# Nominatim REQUIRES a descriptive User-Agent with a way to contact you.
# https://operations.osmfoundation.org/policies/nominatim/
OSM_USER_AGENT=scout-reachy/0.1 (you@example.com)
NOMINATIM_BASE=https://nominatim.openstreetmap.org
OVERPASS_BASE=https://overpass-api.de/api/interpreter
OSM_NEARBY_RADIUS_M=250
# Future higher-quality backend seam; leave blank to stay on free OSM.
GOOGLE_MAPS_API_KEY=

# ---------- Device location (where the robot/laptop is) ----------
# Try Windows WiFi-triangulated location first (needs a laptop + permission).
USE_WINDOWS_LOCATION=true
# Manual fallback: set lat+lon OR a free-text address (geocoded once).
DEVICE_LAT=
DEVICE_LON=
DEVICE_ADDRESS=

# ---------- Trigger ----------
# push_to_talk (press Enter — best outdoors) or wakeword (hands-free).
TRIGGER_MODE=push_to_talk

# ---------- Voice stack ----------
WHISPER_MODEL=base.en
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.5

# ---------- Reachy Mini robot ----------
REACHY_CONNECTION_MODE=localhost_only
REACHY_MEDIA_BACKEND=default
REACHY_SPEAKER_VOLUME=0.55

# ---------- Vision tuning ----------
VISION_MAX_WIDTH=1024
